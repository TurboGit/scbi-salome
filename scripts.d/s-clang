inherit-plugin c-clang

#  Adds a mingw variant using the MingW64 clang version
with-variant mingw os@-clang:[v] \
  --env 'add-to-var PATH $MINGW_PREFIX'

function s-clang-vcs()
{
    echo default
    echo none
    echo git
    echo https://github.com/llvm/llvm-project.git
}

function s-clang-archive()
{
    local VERSION=$1

    echo default
    echo none
    echo ftp
    echo ftp://anonymous@ftp.cea.fr/pub/salome/prerequisites
    echo llvm-project-$VERSION.src.tar.gz
}

function s-clang-build-depends()
{
    echo s-cmake
}
